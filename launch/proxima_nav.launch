<launch>
    <!-- Versione di AlterEgo -->
    <arg name="AlterEgoVersion" default="2" />

    <!-- Posizione attuale del robot -->
    <arg name="location" default="navacchio" />

    <!-- Percorso del file della mappa -->
    <arg name="map_file" value="$(find alterego_navigation)/config/$(arg location)_config/maps/navacchio.json" />
    <param name="map_file" value="$(arg map_file)" />

    <arg name="initial_waypoint" value="Scrivania" />
    <param name="initial_waypoint" value="$(arg initial_waypoint)" />
    
    <group ns="$(env ROBOT_NAME)"> 

        <node pkg="alterego_navigation" type="nav2points_proxima.py" name="navigation" output="screen">
                    
        </node>

    </group>

</launch>
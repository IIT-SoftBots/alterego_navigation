<?xml version="1.0"?>
<package format="3">
  <name>alterego_navigation</name>
  <version>0.11.0</version>
  <description>Navigation helper nodes (waypoint services, key point detection) for AlterEGO (ROS2 port).</description>

  <url type="website">https://www.naturalmachinemotioninitiative.com/ego</url>
  <url type="repository">https://github.com/IIT-SoftBots/AlterEGO_v2</url>

  <author>NMMI</author>
  <author>Istituto Italiano di Tecnologia, Soft Robotics for Human Cooperation and Rehabilitation Lab</author>
  <author>Centro di Ricerca E. Piaggio</author>
  <maintainer email="mattia.poggiani@iit.it">Mattia Poggiani</maintainer>

  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>alterego_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
